{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna-bert.local/specs/002-dist-tokenizer/contracts/tokenizer-state.schema.json",
  "title": "TfidfTokenizer State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "tokenizer_name",
    "config",
    "total_documents",
    "total_shards",
    "candidate_stats",
    "vocabulary"
  ],
  "properties": {
    "format_version": {
      "type": "string"
    },
    "tokenizer_name": {
      "type": "string",
      "const": "TfidfTokenizer"
    },
    "saved_at": {
      "type": "string"
    },
    "total_documents": {
      "type": "integer",
      "minimum": 0
    },
    "total_shards": {
      "type": "integer",
      "minimum": 0
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unk_token",
        "special_tokens",
        "standard_residues",
        "rare_residues",
        "rare_residue_policy",
        "normalize",
        "case_sensitive",
        "min_k",
        "max_k",
        "min_tf",
        "min_df",
        "vocab_size",
        "tf_mode",
        "idf_mode",
        "scoring_mode",
        "alpha",
        "filter_low_complexity",
        "low_complexity_threshold",
        "search_method",
        "merge_strategy"
      ],
      "properties": {
        "unk_token": { "type": "string" },
        "special_tokens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "standard_residues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rare_residues": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rare_residue_policy": {
          "type": "string",
          "enum": ["keep", "replace_with_unk", "replace_with_nn"]
        },
        "fallback_residue": { "type": "string" },
        "normalize": { "type": "boolean" },
        "case_sensitive": { "type": "boolean" },
        "min_k": { "type": "integer", "minimum": 1 },
        "max_k": { "type": "integer", "minimum": 1 },
        "min_tf": { "type": "integer", "minimum": 1 },
        "min_df": { "type": "integer", "minimum": 1 },
        "vocab_size": { "type": "integer", "minimum": 1 },
        "tf_mode": {
          "type": "string",
          "enum": ["raw", "log"]
        },
        "idf_mode": {
          "type": "string",
          "enum": ["standard", "smooth", "probabilistic"]
        },
        "scoring_mode": {
          "type": "string",
          "enum": ["tfidf", "log_tfidf", "complexity_regularized_tfidf"]
        },
        "alpha": { "type": "number" },
        "filter_low_complexity": { "type": "boolean" },
        "low_complexity_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "search_method": {
          "type": "string",
          "enum": ["brute", "beam"]
        },
        "beam_width": {
          "type": "integer",
          "minimum": 1
        },
        "merge_strategy": {
          "type": "string",
          "enum": ["accumulate", "replace_vocab", "freeze_vocab"]
        }
      }
    },
    "candidate_stats": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "length", "tf", "df"],
        "properties": {
          "token": { "type": "string" },
          "length": { "type": "integer", "minimum": 1 },
          "tf": { "type": "integer", "minimum": 1 },
          "df": { "type": "integer", "minimum": 1 },
          "idf": { "type": "number" },
          "complexity": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "length_bonus": { "type": "number" },
          "score": { "type": "number" },
          "is_low_complexity_filtered": { "type": "boolean" }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "token_id",
          "vocabulary_order",
          "token_type",
          "length",
          "tf",
          "df",
          "idf",
          "complexity",
          "score"
        ],
        "properties": {
          "token": { "type": "string" },
          "token_id": { "type": "integer", "minimum": 0 },
          "vocabulary_order": { "type": "integer", "minimum": 0 },
          "token_type": {
            "type": "string",
            "enum": ["special", "single_character", "learned"]
          },
          "length": { "type": "integer", "minimum": 1 },
          "tf": { "type": "integer", "minimum": 0 },
          "df": { "type": "integer", "minimum": 0 },
          "idf": { "type": "number" },
          "complexity": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "score": { "type": "number" }
        }
      }
    }
  }
}
